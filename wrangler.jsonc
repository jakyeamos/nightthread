{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nightthread",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nightthread",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_ASSETS",
      "bucket_name": "nightthread-private-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TRIP_ROOMS",
        "class_name": "TripRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TripRoom"]
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
