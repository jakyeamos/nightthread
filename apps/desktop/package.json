{
  "name": "@nightthread/desktop",
  "version": "0.1.0-beta.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && node scripts/copy-assets.mjs",
    "dev": "pnpm build && cross-env NIGHTTHREAD_DESKTOP_DEV=true NIGHTTHREAD_WEB_ORIGIN=http://localhost:3000 electron .",
    "e2e": "pnpm build && playwright test --config playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "package": "pnpm build && electron-builder --publish never",
    "release": "pnpm build && electron-builder --publish always"
  },
  "dependencies": {
    "@nightthread/desktop-contract": "workspace:*",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@playwright/test": "^1.61.1",
    "cross-env": "^7.0.3",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
